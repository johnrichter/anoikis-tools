{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/bootstrap.sh\""
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash|Read",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse-forced-use.sh\""
                    }
                ]
            }
        ]
    }
}
