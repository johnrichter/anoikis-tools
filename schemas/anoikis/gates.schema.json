{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anoikis.dev/anoikis/gates.schema.json",
  "title": "Anoikis gate policy",
  "description": "Per-gate policy and status. Membership is not here — a node's gate is the shard it lives in — so this file can never disagree with the graph about which nodes a gate covers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gates"],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "policy", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/token" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pause", "deep_review", "merge_target", "sign"],
            "properties": {
              "pause": { "type": "boolean" },
              "deep_review": { "enum": ["batched", "none"] },
              "merge_target": {
                "description": "The branch this gate's merge targets, or \"none\". Only the policy's declared main branch triggers operator confirmation, re-signing and a signed merge commit.",
                "type": "string",
                "minLength": 1
              },
              "sign": { "enum": ["inherit", "none"] }
            }
          },
          "status": { "enum": ["pending", "reviewing", "passed", "merged"] }
        }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "token": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" }
  }
}
