{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anoikis.dev/anoikis/run-result.schema.json",
  "title": "Anoikis node run result",
  "description": "What one node's run produced, as the engine durably records it. Structured diagnostics live here rather than in a second error store, and a failing excerpt is copied in because the raw log dies with the node's worktree.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "node_id", "run_id", "status"],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "node_id": { "$ref": "#/$defs/token" },
    "run_id": { "$ref": "#/$defs/token" },
    "status": { "enum": ["pass", "fail"] },
    "verdict": {
      "description": "A review's structured verdict, when this run carried one. Its vocabulary is the harness policy's, never inferred from prose.",
      "$ref": "#/$defs/token"
    },
    "attribution": {
      "description": "Where the run executed, so the usage provider can price it. Identity only: cost and tokens are never self-reported by the agent that ran, because it cannot measure its own billed usage.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": { "$ref": "#/$defs/token" },
        "agent": { "$ref": "#/$defs/token" },
        "transcript_ref": { "type": "string", "minLength": 1 }
      }
    },
    "artifact_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 0 },
          "severity": { "enum": ["error", "warning", "info"] },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "overflow_count": { "type": "integer", "minimum": 0 },
    "excerpt": {
      "description": "The failing slice of an otherwise ephemeral log, copied here so a post-mortem never depends on a worktree that has been removed.",
      "type": "string",
      "maxLength": 8000
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "impact", "urgency"],
        "properties": {
          "statement": { "type": "string", "minLength": 1 },
          "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
          "urgency": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    },
    "duration_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "token": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" }
  }
}
