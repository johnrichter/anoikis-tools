{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anoikis.dev/anoikis/graph-shard.schema.json",
  "title": "Anoikis graph shard",
  "description": "One gate's slice of the graph, holding only what admission needs: identity, status, edges, and the resource surface each node claims. Full node detail lives behind detail_ref so the hot path stays small. Gate membership is the shard a node lives in — there is no second membership list anywhere.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "nodes"],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "gate_id": { "$ref": "#/$defs/token" },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "token": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "surface", "verify_tier", "detail_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "status": { "enum": ["blocked", "ready", "running", "done", "failed", "archived"] },
        "deps": { "type": "array", "items": { "$ref": "#/$defs/token" } },
        "never_dispatch": {
          "description": "True for work the engine performs itself. Admission structurally refuses to hand such a node to an agent.",
          "type": "boolean"
        },
        "surface": {
          "description": "Every resource this node claims, by domain. An empty surface is legal and makes the node unsafe to co-batch — there is nothing to prove disjoint.",
          "type": "array",
          "items": { "$ref": "#/$defs/claim" }
        },
        "verify_tier": { "enum": ["cheap", "gate", "immediate_deep"] },
        "detail_ref": { "type": "string", "minLength": 1 },
        "attempts": { "type": "integer", "minimum": 0 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "grafted_from": {
          "description": "Present on a node the engine inserted itself in response to a fix verdict, naming the nodes reviewed.",
          "type": "array",
          "items": { "$ref": "#/$defs/token" }
        },
        "tombstone": {
          "description": "What an archived node leaves behind in the hot shard, so a live node's archived dependency still resolves to done.",
          "type": "object",
          "additionalProperties": false,
          "required": ["summary"],
          "properties": {
            "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
            "cost_usd": { "type": "number", "minimum": 0 },
            "cost_known": { "type": "boolean" }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "value"],
      "properties": {
        "domain": { "$ref": "#/$defs/token" },
        "kind": { "type": "string", "maxLength": 32 },
        "value": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "required": { "type": "boolean" }
      }
    }
  }
}
