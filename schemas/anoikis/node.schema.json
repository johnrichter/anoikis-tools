{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anoikis.dev/anoikis/node.schema.json",
  "title": "Anoikis node detail",
  "description": "Everything about one node that is read only when it is dispatched or inspected: what it is for, what would make it acceptable, which stages run it, and what it produced. Kept out of the graph shard so the scheduling hot path never pays for it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "intent", "deliverable_kind", "acceptance", "stages"],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "id": { "$ref": "#/$defs/token" },
    "intent": { "type": "string", "minLength": 1 },
    "deliverable_kind": { "enum": ["code", "docs"] },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "stages": {
      "description": "Build-side stages only, in run order. Review is never a stage; it is chosen by verify_tier.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "role", "model"],
        "properties": {
          "stage": { "$ref": "#/$defs/token" },
          "role": { "$ref": "#/$defs/token" },
          "model": { "type": "string", "minLength": 1 },
          "context_window": { "type": "string", "minLength": 1 },
          "effort": { "type": "string", "minLength": 1 },
          "model_justification": { "type": "string", "minLength": 1 }
        }
      }
    },
    "worktree_ref": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "run_result_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "finding_refs": { "type": "array", "items": { "$ref": "#/$defs/token" } },
        "usage": { "$ref": "#/$defs/usage" }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "token": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "usage": {
      "description": "Spend and tokens for a run, always from the usage provider and never self-reported by the agent that ran. known=false means the provider could not price the run; the figures are then meaningless and must not be summed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["known"],
      "properties": {
        "known": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
